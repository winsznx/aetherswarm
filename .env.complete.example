# AetherSwarm Environment Configuration Template

# ===========================================
# BLOCKCHAIN CONFIGURATION
# ===========================================

# Polygon Amoy Testnet (Primary)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGONSCAN_API_KEY=

# Base Sepolia Testnet (Alternative)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# ===========================================
# WALLET CONFIGURATION
# ===========================================

# Deployer wallet (for contract deployment)
DEPLOYER_PRIVATE_KEY=

# Agent wallets (one per agent type)
SCOUT_WALLET_PRIVATE_KEY=
VERIFIER_WALLET_PRIVATE_KEY=
SYNTHESIZER_WALLET_PRIVATE_KEY=

# ===========================================
# SMART CONTRACT ADDRESSES
# ===========================================
# (Filled automatically after deployment)

AGENT_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
QUEST_LOGGER_ADDRESS=

# ===========================================
# AGENT IDENTITIES (ERC-8004)
# ===========================================
# (Filled automatically after agent registration)

SCOUT_AGENT_ID=
VERIFIER_AGENT_ID=
SYNTHESIZER_AGENT_ID=

# ===========================================
# CROSSMINT CONFIGURATION
# ===========================================

# Get from: https://www.crossmint.com/console/api-keys
CROSSMINT_API_KEY=
CROSSMINT_PROJECT_ID=

# ===========================================
# PREMIUM API KEYS (x402)
# ===========================================

# Perplexity AI - https://www.perplexity.ai/settings/api
# Pricing: ~$0.05 per search
PERPLEXITY_API_KEY=

# Tavily Search - https://tavily.com/
# Pricing: ~$0.02 per search
TAVILY_API_KEY=

# Helius - https://dev.helius.xyz/
# Pricing: ~$0.01 per request (Solana data)
HELIUS_API_KEY=

# Neynar - https://neynar.com/
# Pricing: ~$0.01 per request (Farcaster data)
NEYNAR_API_KEY=

# ===========================================
# EIGENLAYER / TEE CONFIGURATION
# ===========================================

# EigenCloud TEE endpoint for verification
EIGENCLOUD_TEE_ENDPOINT=
EIGENCLOUD_ATTESTATION_KEY=

# ===========================================
# IPFS / STORAGE
# ===========================================

PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================

# Reown (WalletConnect) Project ID
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Public contract addresses for frontend
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_REPUTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_QUEST_LOGGER_ADDRESS=

# ===========================================
# OPTIONAL: ADDITIONAL SERVICES
# ===========================================

# OpenAI (for Synthesizer fallback)
OPENAI_API_KEY=

# Anthropic (alternative)
ANTHROPIC_API_KEY=

# Alchemy / Infura (alternative RPC)
ALCHEMY_API_KEY=
INFURA_API_KEY=
