{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "cargo build --release",
        "watchPatterns": [
            "agents/verifier/**",
            "Cargo.toml"
        ]
    },
    "deploy": {
        "startCommand": "./target/release/verifier-agent",
        "restartPolicyType": "on_failure",
        "restartPolicyMaxRetries": 5
    }
}