{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "cargo build --release && mkdir -p ./bin && cp ./target/release/verifier-agent ./bin/verifier-agent",
        "watchPatterns": [
            "agents/verifier/**",
            "Cargo.toml"
        ]
    },
    "deploy": {
        "startCommand": "./bin/verifier-agent",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
    }
}