# x402 Test Endpoints Configuration
# These are test endpoints that support the x402 payment protocol

# Faremeter Test API (Official x402 test endpoint)
FAREMETER_TEST_API=https://api.faremeter.com/v1/test

# Corbits Test Endpoints
CORBITS_WEATHER_API=https://api.corbits.com/weather
CORBITS_NEWS_API=https://api.corbits.com/news

# Custom Test Endpoints (if you have your own x402 server)
CUSTOM_X402_ENDPOINT_1=http://localhost:4000/api/data
CUSTOM_X402_ENDPOINT_2=http://localhost:4000/api/research

# Default test sources for Scout agent
DEFAULT_X402_SOURCES=https://api.faremeter.com/v1/test,https://api.corbits.com/weather

# x402 Configuration
X402_MAX_PAYMENT_AMOUNT=1000000  # 1 USDC (6 decimals)
X402_PAYMENT_TIMEOUT=3600  # 1 hour
X402_RETRY_ATTEMPTS=3
