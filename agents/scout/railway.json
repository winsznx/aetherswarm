{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "watchPatterns": [
            "agents/scout/**",
            "requirements.txt"
        ]
    },
    "deploy": {
        "startCommand": "python -m src.main",
        "restartPolicyType": "on_failure",
        "restartPolicyMaxRetries": 5
    }
}